#!/usr/bin/env python3
"""kindle-send: send local ebooks to a Kindle by email or USB.

Standard library only. See docs/spec.md.
"""
import argparse
import contextlib
import io
import json
import os
import shutil
import smtplib
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta
from email.message import EmailMessage
from pathlib import Path

PLUGIN_ID = "sorydi3.kindle-send"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
SMTP_TIMEOUT = 60

# Formats Amazon accepts by email (spec §5), with the MIME type to attach them as.
EMAIL_MIME = {
    "epub": "application/epub+zip",
    "pdf": "application/pdf",
    "txt": "text/plain",
    "doc": "application/msword",
    "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "rtf": "application/rtf",
    "html": "text/html",
    "htm": "text/html",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "gif": "image/gif",
    "bmp": "image/bmp",
}


def book_format(book):
    """Lower-case extension without the dot, e.g. 'epub'."""
    return Path(book).suffix.lower().lstrip(".")


def emit(obj):
    print(json.dumps(obj), flush=True)


def shell_json_path():
    override = os.environ.get("KINDLE_SEND_SHELL_JSON")
    if override:
        return Path(override)
    config = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(config) / "omarchy" / "shell.json"


def load_settings():
    """The plugin's entry from shell.json, or {} if there is none."""
    try:
        data = json.loads(shell_json_path().read_text())
    except (OSError, ValueError):
        return {}
    for entry in data.get("plugins", []) if isinstance(data, dict) else []:
        if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
            return entry
    return {}


def lookup_password(sender):
    """App password from the keyring via `secret-tool lookup`; None if missing or empty."""
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", "kindle-send", "user", sender],
            capture_output=True, text=True,
        )
    except OSError:
        return None
    password = out.stdout.rstrip("\n") if out.returncode == 0 else ""
    return password or None


def build_message(book, sender, kindle):
    book = Path(book)
    msg = EmailMessage()
    msg["From"] = sender
    msg["To"] = kindle
    msg["Subject"] = book.stem
    msg.set_content("Sent by kindle-send.")
    maintype, subtype = EMAIL_MIME[book_format(book)].split("/")
    msg.add_attachment(book.read_bytes(), maintype=maintype, subtype=subtype, filename=book.name)
    return msg


class SendFailed(Exception):
    """A per-Book failure, reported as a result line rather than a crash."""

    def __init__(self, reason, fix_by_setup=False):
        super().__init__(reason)
        self.reason = reason
        self.fix_by_setup = fix_by_setup

    def result(self):
        line = {"result": "failed", "reason": self.reason}
        if self.fix_by_setup:
            line["fixBySetup"] = True
        return line


EMAIL_SETTINGS = ("kindleAddress", "senderAddress")


def missing_settings(settings, required=EMAIL_SETTINGS):
    """Names of required settings that are absent or blank, in a stable order."""
    return [key for key in required if not str(settings.get(key) or "").strip()]


def state_dir():
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "kindle-send"


def save_email_limit(advertised):
    """Cache Gmail's advertised size so `plan` can estimate the Email limit (spec §5)."""
    path = state_dir() / "email-limit.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"advertised": advertised}) + "\n")


HISTORY_DAYS = 90


def history_path():
    return state_dir() / "history.jsonl"


def read_history():
    """All Send history entries, oldest first. Unreadable lines are skipped."""
    try:
        lines = history_path().read_text().splitlines()
    except OSError:
        return []
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            entries.append(entry)
    return entries


def entry_time(entry):
    try:
        when = datetime.fromisoformat(entry["time"])
    except (KeyError, TypeError, ValueError):
        return None
    return when if when.tzinfo else when.astimezone()


def record_send(book, route, result):
    """Append one Book's result to the Send history, dropping entries older than 90 days."""
    now = datetime.now().astimezone()
    try:
        size = book.stat().st_size
    except OSError:
        size = 0
    entry = {"time": now.isoformat(timespec="seconds"), "name": book.name, "size": size,
             "route": route, "result": result["result"]}
    if "reason" in result:
        entry["reason"] = result["reason"]
    cutoff = now - timedelta(days=HISTORY_DAYS)
    kept = [e for e in read_history() if (entry_time(e) or now) >= cutoff]
    path = history_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text("".join(json.dumps(e) + "\n" for e in kept + [entry]))
    os.replace(tmp, path)


def send_email(book):
    fmt = book_format(book)
    if fmt not in EMAIL_MIME:
        raise SendFailed(f"{fmt.upper()} can't be sent by email. Switch it to USB.")
    if not book.is_file():
        raise SendFailed(f"File not found: {book.name}.")
    settings = load_settings()
    missing = missing_settings(settings)
    if missing:
        raise SendFailed(f"Not set up: {', '.join(missing)} missing.", fix_by_setup=True)
    sender, kindle = settings["senderAddress"], settings["kindleAddress"]
    password = lookup_password(sender)
    if not password:
        raise SendFailed("No app password stored.", fix_by_setup=True)
    emit({"stage": "sending"})
    msg = build_message(book, sender, kindle)
    too_big = SendFailed(f"Too big for email ({megabytes(book.stat().st_size)} MB). Switch it to USB.")
    try:
        with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, timeout=SMTP_TIMEOUT) as server:
            server.ehlo()
            server.login(sender, password)
            advertised = advertised_size(server)
            if advertised:
                save_email_limit(advertised)
                if len(msg.as_bytes()) > advertised:
                    raise too_big
            server.send_message(msg)
    except smtplib.SMTPAuthenticationError:
        raise SendFailed("Gmail rejected the app password.", fix_by_setup=True) from None
    except smtplib.SMTPResponseException as error:
        if error.smtp_code == 552:
            raise too_big from None
        raise unreachable(error, password) from None
    except (smtplib.SMTPException, OSError) as error:
        raise unreachable(error, password) from None
    return {"result": "sent"}


def megabytes(size):
    return max(1, round(size / 1_000_000))


def advertised_size(server):
    """Gmail's maximum message size from its EHLO SIZE line, or None."""
    try:
        return int(server.esmtp_features.get("size", "")) or None
    except ValueError:
        return None


def unreachable(error, password):
    # Never let the password leak into a reason, whatever the server echoes.
    return SendFailed(f"Couldn't reach Gmail: {error_text(error).replace(password, '***')}.")


def error_text(error):
    """A short, password-free description of an SMTP or network error."""
    if isinstance(error, smtplib.SMTPResponseException):
        message = error.smtp_error
        if isinstance(message, bytes):
            message = message.decode("utf-8", "replace")
        return f"{error.smtp_code} {message}".strip()
    return str(error) or type(error).__name__


# Formats the USB Route takes (spec §5); EPUB after Conversion.
USB_FORMATS = {"epub", "pdf", "txt", "azw3", "azw", "mobi", "prc", "kfx"}


def book_folders(settings):
    folders = settings.get("bookFolders")
    if not isinstance(folders, list) or not folders:
        folders = DEFAULT_BOOK_FOLDERS
    return [Path(os.path.expanduser(str(f))) for f in folders]


SUBFOLDER_DEPTH = 3


def supported(book):
    fmt = book_format(book)
    return fmt in EMAIL_MIME or fmt in USB_FORMATS


def scan_folders(folders):
    """Supported Books in the Book folders and up to 3 levels of subfolders, hidden folders skipped."""
    books = []

    def walk(folder, depth):
        try:
            entries = sorted(folder.iterdir())
        except OSError:
            return
        for entry in entries:
            if entry.is_dir():
                if depth < SUBFOLDER_DEPTH and not entry.name.startswith("."):
                    walk(entry, depth + 1)
            elif entry.is_file() and supported(entry):
                books.append(entry)

    for folder in folders:
        walk(folder, 0)
    return books


DEFAULT_ADVERTISED = 35_882_577
EMAIL_OVERHEAD = 64 * 1024
BASE64_GROWTH = 1.37


def email_limit():
    """Estimated largest Book the Email route takes, from the cached advertised size (spec §5)."""
    try:
        advertised = int(json.loads((state_dir() / "email-limit.json").read_text())["advertised"])
    except (OSError, ValueError, KeyError, TypeError):
        advertised = DEFAULT_ADVERTISED
    return int((advertised - EMAIL_OVERHEAD) / BASE64_GROWTH)


def choose_route(fmt, size, limit):
    """Route rules 1 and 2: Email if the format and size allow it, otherwise USB."""
    usb_ok = fmt in USB_FORMATS
    if fmt not in EMAIL_MIME:
        return {"route": "usb", "routeReason": f"{fmt.upper()} can't be sent by email.",
                "emailOk": False, "usbOk": usb_ok}
    if size > limit:
        return {"route": "usb", "routeReason": f"Too big for email ({megabytes(size)} MB).",
                "emailOk": False, "usbOk": usb_ok}
    return {"route": "email", "routeReason": "", "emailOk": True, "usbOk": usb_ok}


def last_sent(history):
    """(name, size) -> time of the latest successful Send, from the Send history."""
    latest = {}
    for entry in history:
        when = entry_time(entry)
        if when is None or entry.get("result") not in ("sent", "copied"):
            continue
        key = (entry.get("name"), entry.get("size"))
        if key not in latest or when >= latest[key][0]:
            latest[key] = (when, entry["time"])
    return {key: value[1] for key, value in latest.items()}


def classify(book, limit, sent):
    st = book.stat()
    fmt = book_format(book)
    return {"path": str(book), "name": book.name, "format": fmt, "size": st.st_size,
            "mtime": int(st.st_mtime), **choose_route(fmt, st.st_size, limit),
            "lastSent": sent.get((book.name, st.st_size))}


def plan(folders_wanted, files):
    """Classify Books for the Picker (spec §3), newest first."""
    settings = load_settings()
    missing = missing_settings(settings)
    if missing:
        emit({"setupNeeded": True, "missing": missing})
    books = scan_folders(book_folders(settings)) if folders_wanted else []
    books += [Path(f) for f in files if Path(f).is_file() and supported(Path(f))]
    unique = {}
    for book in books:
        unique.setdefault(book.resolve(), book)
    limit, sent = email_limit(), last_sent(read_history())
    rows = [classify(book, limit, sent) for book in unique.values()]
    rows.sort(key=lambda row: row["mtime"], reverse=True)
    for row in rows:
        emit(row)


# --- setup wizard (spec §9) -------------------------------------------------


AMAZON_DEVICES_HELP = "https://www.amazon.com/mycd"
APP_PASSWORDS_URL = "https://myaccount.google.com/apppasswords"
DEFAULT_BOOK_FOLDERS = ["~/Books", "~/Downloads"]
DEFAULT_LIMITS = {"minEmailGapSeconds": 10, "maxEmailsPerHour": 20}


class SetupCancelled(Exception):
    pass


def ask(prompt, current=None):
    """One line from the user; Enter keeps `current`. Never used for the password."""
    shown = f"{prompt} [{current}]: " if current else f"{prompt}: "
    while True:
        try:
            answer = input(shown).strip()
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None
        if answer:
            return answer
        if current:
            return current


def ask_address(prompt, current):
    while True:
        address = ask(prompt, current)
        if "@" in address and " " not in address:
            return address
        print("That doesn't look like an email address.")


def ask_yes_no(prompt, default):
    hint = "Y/n" if default else "y/N"
    while True:
        try:
            answer = input(f"{prompt} [{hint}]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None
        if not answer:
            return default
        if answer in ("y", "yes", "n", "no"):
            return answer.startswith("y")


def store_password(sender):
    """Let `secret-tool store` prompt in the terminal; the wizard never sees the password."""
    while True:
        print("Paste the app password at the prompt below (it isn't shown).")
        try:
            subprocess.run(["secret-tool", "store", "--label=kindle-send Gmail",
                            "service", "kindle-send", "user", sender])
        except OSError:
            print("secret-tool is missing. Install libsecret, then run setup again.")
            raise SetupCancelled from None
        if lookup_password(sender):
            print("App password stored in the keyring.")
            return
        print("Nothing was stored.")
        try:
            input("Press Enter to try again. ")
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None


def password_step(sender):
    print(f"\n3. Gmail app password. Create one at {APP_PASSWORDS_URL}")
    print("   (needs 2-Step Verification on the Google account).")
    if lookup_password(sender):
        if not ask_yes_no("An app password is stored. Replace it?", False):
            return
    store_password(sender)


def save_settings(updates):
    """Merge `updates` into the plugin's entry in shell.json, keeping everything else."""
    path = shell_json_path()
    try:
        text = path.read_text()
    except FileNotFoundError:
        text = ""
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError:
        data = None
    if not isinstance(data, dict):
        print(f"{path} isn't valid JSON, so setup won't touch it. Fix it and run setup again.")
        raise SetupCancelled
    plugins = data.setdefault("plugins", [])
    entry = next((p for p in plugins if isinstance(p, dict) and p.get("id") == PLUGIN_ID), None)
    if entry is None:
        entry = {"id": PLUGIN_ID}
        plugins.append(entry)
    for key, value in DEFAULT_LIMITS.items():
        entry.setdefault(key, value)
    entry.update(updates)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".kindle-send.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(json.dumps(data, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def wizard():
    current = load_settings()
    print("Send to Kindle setup. Press Enter to keep the value in [brackets].\n")

    print("1. Your Kindle's email address (…@kindle.com). Find it at")
    print(f"   amazon.com → Manage Your Content and Devices → Devices: {AMAZON_DEVICES_HELP}")
    kindle = ask_address("Kindle address", current.get("kindleAddress"))

    print("\n2. The Gmail address to send from.")
    sender = ask_address("Gmail address", current.get("senderAddress"))

    password_step(sender)

    print(f"\n4. Add {sender} to Amazon's Approved Personal Document Email List:")
    print(f"   {AMAZON_DEVICES_HELP} → Preferences → Personal Document Settings.")
    print("   Without this, Amazon silently drops every Book.")
    try:
        input("Press Enter when done. ")
    except (EOFError, KeyboardInterrupt):
        raise SetupCancelled from None

    print("\n5. Book folders the Picker lists, separated by commas.")
    folders = current.get("bookFolders") or DEFAULT_BOOK_FOLDERS
    answer = ask("Book folders", ", ".join(folders))
    folders = [f.strip() for f in answer.split(",") if f.strip()]

    save_settings({"kindleAddress": kindle, "senderAddress": sender, "bookFolders": folders})
    print(f"Settings saved to {shell_json_path()}.")

    books = Path.home() / "Books"
    if not books.is_dir():
        books.mkdir(parents=True)
        print(f"Created {books}.")

    print("\n7. Test send.")
    if ask_yes_no(f"Send a small test Book to {kindle} now?", True):
        run_test_send(kindle)
    print("\nSetup done.")


TEST_BOOK_TITLE = "Kindle Send Test"


def test_epub_path():
    """The bundled test EPUB: $KINDLE_SEND_TEST_EPUB, else assets/test.epub beside bin/."""
    override = os.environ.get("KINDLE_SEND_TEST_EPUB")
    if override:
        return Path(override)
    return Path(__file__).resolve().parent.parent / "assets" / "test.epub"


def run_test_send(kindle):
    """Email the test EPUB, named after its title (the subject), then ask whether it arrived."""
    with tempfile.TemporaryDirectory(prefix="kindle-send-") as tmp:
        book = Path(tmp) / f"{TEST_BOOK_TITLE}.epub"
        try:
            shutil.copyfile(test_epub_path(), book)
        except OSError as error:
            print(f"Couldn't find the test Book ({error}). Reinstall kindle-send.")
            return
        print("Sending…")
        try:
            with contextlib.redirect_stdout(io.StringIO()):  # no JSON progress lines here
                result = send_email(book)
        except SendFailed as failure:
            result = failure.result()
        record_send(book, "email", result)
    if result["result"] != "sent":
        print(f"The test send failed: {result['reason']}")
        print("Fix that and run `kindle-send setup` again.")
        return
    print("Gmail accepted it. Amazon never confirms delivery, so check your Kindle.")
    if ask_yes_no(f"Did '{TEST_BOOK_TITLE}' appear on your Kindle within a few minutes?", True):
        print("Send to Kindle is ready.")
        return
    print("The usual causes:")
    print("  - The Gmail address isn't on Amazon's Approved Personal Document Email List")
    print(f"    ({AMAZON_DEVICES_HELP} → Preferences → Personal Document Settings).")
    print(f"  - The Kindle address is wrong: check {kindle} against the one under")
    print("    Manage Your Content and Devices → Devices.")
    print("  - The Kindle is offline. It downloads the Book next time it's on Wi-Fi.")
    print("Fix it and run `kindle-send setup` again.")


def run_setup():
    if not sys.stdin.isatty():
        print("kindle-send setup needs a terminal. Run `kindle-send setup` in one.", file=sys.stderr)
        return 1
    try:
        wizard()
    except SetupCancelled:
        print("\nSetup cancelled.")
        return 1
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="kindle-send")
    sub = parser.add_subparsers(dest="command", required=True)
    send = sub.add_parser("send", help="send one Book")
    send.add_argument("--route", choices=["email"], required=True)
    send.add_argument("file")
    sub.add_parser("setup", help="interactive setup wizard (needs a terminal)")
    plan_parser = sub.add_parser("plan", help="classify Books for the Picker")
    plan_parser.add_argument("--folders", action="store_true", help="scan the Book folders")
    plan_parser.add_argument("files", nargs="*")
    sub.add_parser("formats", help="list the supported formats (read by the Nautilus extension)")
    args = parser.parse_args(argv)

    if args.command == "formats":
        emit({"formats": sorted(set(EMAIL_MIME) | USB_FORMATS)})
        return 0

    if args.command == "plan":
        plan(args.folders, args.files)
        return 0
    if args.command == "setup":
        return run_setup()

    if args.command == "send":
        book = Path(args.file)
        try:
            result = send_email(book)
        except SendFailed as failure:
            result = failure.result()
        record_send(book, args.route, result)
        emit(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
