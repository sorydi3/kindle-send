#!/usr/bin/env python3
"""kindle-send: send local ebooks to a Kindle by email or USB.

Standard library only. See docs/spec.md.
"""
import argparse
import contextlib
import io
import json
import math
import os
import shutil
import smtplib
import ssl
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from email.message import EmailMessage
from pathlib import Path

PLUGIN_ID = "sorydi3.kindle-send"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
SMTP_TIMEOUT = 60

# Formats Amazon accepts by email (spec §5), with the MIME type to attach them as.
EMAIL_MIME = {
    "epub": "application/epub+zip",
    "pdf": "application/pdf",
    "txt": "text/plain",
    "doc": "application/msword",
    "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "rtf": "application/rtf",
    "html": "text/html",
    "htm": "text/html",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "gif": "image/gif",
    "bmp": "image/bmp",
}


def book_format(book):
    """Lower-case extension without the dot, e.g. 'epub'."""
    return Path(book).suffix.lower().lstrip(".")


def emit(obj):
    print(json.dumps(obj), flush=True)


def config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config"))


def settings_path():
    """Where Settings live (spec §9, ADR 0002). kindle-send is its only writer."""
    return config_home() / "kindle-send" / "settings.json"


def shell_json_path():
    """omarchy-shell's own file, where Settings were kept before they had their own file.
    Only ever read, for the one-time copy."""
    override = os.environ.get("KINDLE_SEND_SHELL_JSON")
    if override:
        return Path(override)
    return config_home() / "omarchy" / "shell.json"


SETTING_KEYS = ("kindleAddress", "senderAddress", "bookFolders", "minEmailGapSeconds", "maxEmailsPerHour")


def old_shell_json_settings():
    """The Settings in the plugin's old shell.json entry, or {} if there are none."""
    try:
        data = json.loads(shell_json_path().read_text())
    except (OSError, ValueError):
        return {}
    for entry in data.get("plugins", []) if isinstance(data, dict) else []:
        if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
            return {key: entry[key] for key in SETTING_KEYS if key in entry}
    return {}


class SettingsInvalid(Exception):
    """The Settings file exists but isn't a JSON object, so nothing overwrites it."""

    def __init__(self, path):
        super().__init__(f"{path} isn't valid JSON")
        self.path = path

    def line(self):
        """What `plan` and `settings` print instead of their answer."""
        message = said("settings_file_invalid", path=str(self.path))
        return {"failed": True, "code": message["code"], "values": message["values"], "reason": message["text"]}


def read_settings_file():
    """The Settings file's contents; None if there is no file. SettingsInvalid if unreadable."""
    path = settings_path()
    try:
        text = path.read_text()
    except FileNotFoundError:
        return None
    except OSError:
        raise SettingsInvalid(path) from None
    try:
        data = json.loads(text)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        raise SettingsInvalid(path)
    return data


def write_settings_file(settings):
    """Write the whole Settings file atomically (temp file, then rename), mode 600."""
    write_private(settings_path(), json.dumps(settings, indent=2) + "\n")


def private_dir(path):
    """Create `path` (and its parents) if needed, mode 700. An existing one loses
    any group and other permissions (tightened, never loosened)."""
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    current = stat.S_IMODE(os.stat(path).st_mode)
    if current & 0o077:
        os.chmod(path, current & 0o700)


def write_private(path, text):
    """Replace `path` with `text` atomically, mode 600, in a mode-700 folder.
    The temp file is created afresh (O_EXCL, O_NOFOLLOW): a link left in its
    place is removed, never written through. An existing open file is replaced
    by the new private one."""
    private_dir(path.parent)
    tmp = path.with_name(path.name + ".tmp")
    with contextlib.suppress(FileNotFoundError):
        os.unlink(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as out:
            os.fchmod(out.fileno(), 0o600)  # whatever the umask
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def load_settings():
    """The Settings, or {} if there are none.

    With no Settings file yet, Settings found in the plugin's old shell.json entry
    are copied into one, once; after that shell.json is never read again.
    SettingsInvalid if the file is there but unreadable: it is never taken for
    missing Settings, so nothing asks for setup or writes over it."""
    settings = read_settings_file()
    if settings is not None:
        return settings
    old = old_shell_json_settings()
    if old:
        with contextlib.suppress(OSError):
            write_settings_file(old)
    return old


def lookup_password(sender):
    """App password from the keyring via `secret-tool lookup`; None if missing or empty."""
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", "kindle-send", "user", sender],
            capture_output=True, text=True,
        )
    except OSError:
        return None
    password = out.stdout.rstrip("\n") if out.returncode == 0 else ""
    return password or None


def build_message(book, sender, kindle):
    book = Path(book)
    msg = EmailMessage()
    msg["From"] = sender
    msg["To"] = kindle
    msg["Subject"] = book.stem
    msg.set_content("Sent by kindle-send.")
    maintype, subtype = EMAIL_MIME[book_format(book)].split("/")
    msg.add_attachment(book.read_bytes(), maintype=maintype, subtype=subtype, filename=book.name)
    return msg


# Every sentence the shell shows, by its stable code (spec §17, Translations). The
# shell gets the code, its values and this English text, and may show its own text
# for the code instead. Terminal output, the wizard and the Send history stay English.
MESSAGES = {
    # Send failures (spec §13)
    "too_big_for_email": lambda v: f"Too big for email ({v['mb']} MB). Switch it to USB.",
    "format_not_emailable": lambda v: f"{v['format']} can't be sent by email. Switch it to USB.",
    "format_not_for_usb": lambda v: f"{v['format']} can't be read over USB. Send it by email.",
    "file_not_found": lambda v: f"File not found: {v['name']}.",
    "not_set_up": lambda v: f"Not set up: {', '.join(v['fields'])} missing.",
    "no_app_password": lambda v: "No app password stored.",
    "password_rejected": lambda v: "Gmail rejected the app password.",
    "gmail_unreachable": lambda v: f"Couldn't reach Gmail: {v['detail']}.",
    "gmail_certificate_invalid": lambda v: f"Couldn't verify Gmail's certificate: {v['detail']}.",
    "kindle_not_plugged_in": lambda v: "Kindle not plugged in. Plug it in and send again.",
    "kindle_full": lambda v: f"Not enough space on the Kindle (needs {v['mb']} MB).",
    "copy_failed": lambda v: f"Couldn't copy to the Kindle: {v['detail']}.",
    "calibre_missing": lambda v: "Install calibre to send EPUB over USB (sudo pacman -S calibre).",
    "conversion_failed": lambda v: f"Couldn't convert: {v['detail']}.",
    "test_book_missing": lambda v: "Couldn't find the test Book. Reinstall Books to Kindle.",
    # Why `plan` chose USB (spec §5, Route rules)
    "route_format_not_emailable": lambda v: f"{v['format']} can't be sent by email.",
    "route_too_big_for_email": lambda v: f"Too big for email ({v['mb']} MB).",
    # Eject (spec §7); detail is udisksctl's own first error line
    "eject_no_kindle": lambda v: "Kindle not plugged in.",
    "eject_failed": lambda v: v["detail"],
    "eject_step_failed": lambda v: f"{v['step']} failed.",
    # Settings form problems (spec §3, §9)
    "value_needed": lambda v: "Needed before Books can be sent.",
    "not_an_email_address": lambda v: "That isn't an email address.",
    "kindle_address_unusual": lambda v: "Kindle addresses usually end in @kindle.com.",
    "sender_not_gmail": lambda v: "Make sure this is a Google account.",
    "book_folder_missing": lambda v: f"{v['folder']} doesn't exist, so the Picker skips it.",
    "book_folders_missing": lambda v: f"{and_list(v['folders'])} don't exist, so the Picker skips them.",
    "app_password_rejected": lambda v: "Gmail rejected this app password.",
    "password_check_unreachable": lambda v: "Couldn't reach Gmail to check the password. Saved anyway.",
    "password_check_untrusted": lambda v: ("Couldn't verify Gmail's certificate, so the password wasn't "
                                           f"checked: {v['detail']}. Saved anyway."),
    "secret_tool_missing": lambda v: "secret-tool is missing. Install libsecret, then save again.",
    "password_not_stored": lambda v: "Couldn't store the app password in the keyring.",
    "form_unreadable": lambda v: "The Settings form sent something unreadable.",
    "settings_file_invalid": lambda v: f"{v['path']} isn't valid JSON, so it wasn't changed.",
    "settings_file_unwritable": lambda v: f"Couldn't write {v['path']}: {v['detail']}.",
}


def and_list(items):
    """"a, b and c"."""
    return ", ".join(items[:-1]) + " and " + items[-1]


def said(code, **values):
    """A shell-facing sentence: {"code", "values", "text"}."""
    return {"code": code, "values": values, "text": MESSAGES[code](values)}


class SendFailed(Exception):
    """A per-Book failure, reported as a result line rather than a crash."""

    def __init__(self, code, field="", **values):
        """field: the Setting that fixes it (kindleAddress, senderAddress, appPassword), if any."""
        self.message = said(code, **values)
        super().__init__(self.message["text"])
        self.reason = self.message["text"]
        self.field = field

    def result(self):
        line = {"result": "failed", "code": self.message["code"], "values": self.message["values"],
                "reason": self.reason}
        if self.field:
            line["fixBySetup"] = True
            line["field"] = self.field
        return line


class NoKindle(SendFailed):
    """No Kindle plugged in. The Service holds the Book as a Pending Send, so it
    isn't written to the Send history until it really goes."""

    def __init__(self):
        super().__init__("kindle_not_plugged_in")


EMAIL_SETTINGS = ("kindleAddress", "senderAddress")


def missing_settings(settings, required=EMAIL_SETTINGS):
    """Names of required settings that are absent or blank, in a stable order."""
    return [key for key in required if not str(settings.get(key) or "").strip()]


def state_dir():
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "kindle-send"


def save_email_limit(advertised):
    """Cache Gmail's advertised size so `plan` can estimate the Email limit (spec §5)."""
    write_private(state_dir() / "email-limit.json", json.dumps({"advertised": advertised}) + "\n")


HISTORY_DAYS = 90


def history_path():
    return state_dir() / "history.jsonl"


def read_history():
    """All Send history entries, oldest first. Unreadable lines are skipped."""
    try:
        lines = history_path().read_text().splitlines()
    except OSError:
        return []
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            entries.append(entry)
    return entries


def entry_time(entry):
    try:
        when = datetime.fromisoformat(entry["time"])
    except (KeyError, TypeError, ValueError):
        return None
    return when if when.tzinfo else when.astimezone()


def record_send(book, route, result):
    """Append one Book's result to the Send history, dropping entries older than 90 days."""
    now = datetime.now().astimezone()
    try:
        size = book.stat().st_size
    except OSError:
        size = 0
    entry = {"time": now.isoformat(timespec="seconds"), "name": book.name, "size": size,
             "route": route, "result": result["result"]}
    if "reason" in result:
        entry["reason"] = result["reason"]
    cutoff = now - timedelta(days=HISTORY_DAYS)
    kept = [e for e in read_history() if (entry_time(e) or now) >= cutoff]
    write_private(history_path(), "".join(json.dumps(e) + "\n" for e in kept + [entry]))


def sendable(book, formats, refusal):
    """The Book's format, after checking the Route takes it and the file exists.
    `refusal`: the message code for a format the Route can't take."""
    fmt = book_format(book)
    if fmt not in formats:
        raise SendFailed(refusal, format=fmt.upper())
    if not book.is_file():
        raise SendFailed("file_not_found", name=book.name)
    return fmt


def send_email(book):
    sendable(book, EMAIL_MIME, "format_not_emailable")
    try:
        settings = load_settings()
    except SettingsInvalid as invalid:
        raise SendFailed("settings_file_invalid", path=str(invalid.path)) from None
    missing = missing_settings(settings)
    if missing:
        raise SendFailed("not_set_up", field=missing[0], fields=missing)
    sender, kindle = settings["senderAddress"], settings["kindleAddress"]
    password = lookup_password(sender)
    if not password:
        raise SendFailed("no_app_password", field="appPassword")
    emit({"stage": "sending"})
    msg = build_message(book, sender, kindle)
    too_big = SendFailed("too_big_for_email", mb=megabytes(book.stat().st_size))
    try:
        with connect_gmail() as server:
            server.ehlo()
            sign_in(server, sender, password)
            advertised = advertised_size(server)
            if advertised:
                save_email_limit(advertised)
                if len(msg.as_bytes()) > advertised:
                    raise too_big
            server.send_message(msg)
    except ssl.SSLCertVerificationError as error:
        raise SendFailed("gmail_certificate_invalid",
                         detail=certificate_problem(error).replace(password, "***")) from None
    except smtplib.SMTPAuthenticationError:
        raise SendFailed("password_rejected", field="appPassword") from None
    except smtplib.SMTPResponseException as error:
        if error.smtp_code == 552:
            raise too_big from None
        raise unreachable(error, password) from None
    except (smtplib.SMTPException, OSError) as error:
        raise unreachable(error, password) from None
    return {"result": "sent"}


def connect_gmail():
    """An SMTP connection to Gmail over TLS that verifies Gmail's certificate and
    host name (the system's trusted CAs). Never falls back to an unverified one:
    a certificate Gmail can't prove raises ssl.SSLCertVerificationError."""
    context = ssl.create_default_context()
    return smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, timeout=SMTP_TIMEOUT, context=context)


def certificate_problem(error):
    """What was wrong with the certificate, e.g. "self-signed certificate"."""
    return getattr(error, "verify_message", None) or getattr(error, "reason", None) or str(error) \
        or type(error).__name__


def sign_in(server, user, password):
    """AUTH PLAIN only. On a wrong password Gmail answers 535 and hangs up, and
    smtplib's login() would then retry with AUTH LOGIN and report the hang-up instead."""
    server.user, server.password = user, password
    server.auth("PLAIN", server.auth_plain)


def megabytes(size):
    return max(1, round(size / 1_000_000))


def advertised_size(server):
    """Gmail's maximum message size from its EHLO SIZE line, or None."""
    try:
        return int(server.esmtp_features.get("size", "")) or None
    except ValueError:
        return None


def unreachable(error, password):
    # Never let the password leak into a reason, whatever the server echoes.
    return SendFailed("gmail_unreachable", detail=error_text(error).replace(password, "***"))


def error_text(error):
    """A short, password-free description of an SMTP or network error."""
    if isinstance(error, smtplib.SMTPResponseException):
        message = error.smtp_error
        if isinstance(message, bytes):
            message = message.decode("utf-8", "replace")
        return f"{error.smtp_code} {message}".strip()
    return str(error) or type(error).__name__


# Formats the USB Route takes (spec §5); EPUB after Conversion.
USB_FORMATS = {"epub", "pdf", "txt", "azw3", "azw", "mobi", "prc", "kfx"}


DEFAULT_BOOK_FOLDERS = ["~/Books", "~/Downloads"]
ROUTE_LABELS = {"email": "Email", "usb": "USB"}  # for `kindle-send history`; the Picker names Routes itself


def book_folder_setting(settings):
    """The Book folders as written in settings (`~` unexpanded), else the defaults."""
    folders = settings.get("bookFolders")
    if not isinstance(folders, list) or not folders:
        folders = DEFAULT_BOOK_FOLDERS
    return [str(f) for f in folders]


def book_folders(settings):
    return [Path(os.path.expanduser(f)) for f in book_folder_setting(settings)]


SUBFOLDER_DEPTH = 3


def supported(book):
    fmt = book_format(book)
    return fmt in EMAIL_MIME or fmt in USB_FORMATS


def scan_folders(folders):
    """Supported Books in the Book folders and up to 3 levels of subfolders, hidden folders skipped."""
    books = []

    def walk(folder, depth):
        try:
            entries = sorted(folder.iterdir())
        except OSError:
            return
        for entry in entries:
            if entry.is_dir():
                if depth < SUBFOLDER_DEPTH and not entry.name.startswith("."):
                    walk(entry, depth + 1)
            elif entry.is_file() and supported(entry):
                books.append(entry)

    for folder in folders:
        walk(folder, 0)
    return books


GMAIL_ADVERTISED_SIZE_DEFAULT = 35_882_577
EMAIL_OVERHEAD = 64 * 1024
BASE64_GROWTH = 1.37


def email_limit():
    """Estimated largest Book the Email route takes, from the cached advertised size (spec §5)."""
    try:
        advertised = int(json.loads((state_dir() / "email-limit.json").read_text())["advertised"])
    except (OSError, ValueError, KeyError, TypeError):
        advertised = GMAIL_ADVERTISED_SIZE_DEFAULT
    return int((advertised - EMAIL_OVERHEAD) / BASE64_GROWTH)


def choose_route(fmt, size, limit):
    """Route rules 1 and 2: Email if the format and size allow it, otherwise USB."""
    usb_ok = fmt in USB_FORMATS
    if fmt not in EMAIL_MIME:
        return {"route": "usb", **route_reason("route_format_not_emailable", format=fmt.upper()),
                "emailOk": False, "usbOk": usb_ok}
    if size > limit:
        return {"route": "usb", **route_reason("route_too_big_for_email", mb=megabytes(size)),
                "emailOk": False, "usbOk": usb_ok}
    return {"route": "email", "routeReason": "", "routeReasonCode": "", "routeReasonValues": {},
            "emailOk": True, "usbOk": usb_ok}


def route_reason(code, **values):
    """Why `plan` chose USB, as routeReason (English), routeReasonCode and routeReasonValues."""
    message = said(code, **values)
    return {"routeReason": message["text"], "routeReasonCode": code, "routeReasonValues": message["values"]}


def last_sent(history):
    """(name, size) -> time of the latest successful Send, from the Send history."""
    latest = {}
    for entry in history:
        when = entry_time(entry)
        if when is None or entry.get("result") not in ("sent", "copied"):
            continue
        key = (entry.get("name"), entry.get("size"))
        if key not in latest or when >= latest[key][0]:
            latest[key] = (when, entry["time"])
    return {key: value[1] for key, value in latest.items()}


def classify(book, limit, sent):
    st = book.stat()
    fmt = book_format(book)
    return {"path": str(book), "name": book.name, "format": fmt, "size": st.st_size,
            "mtime": int(st.st_mtime), **choose_route(fmt, st.st_size, limit),
            "lastSent": sent.get((book.name, st.st_size))}


def plan(folders_wanted, files):
    """Classify Books for the Picker (spec §3), newest first. An unreadable
    Settings file is the one line printed: without its Book folders there is no list."""
    try:
        settings = load_settings()
    except SettingsInvalid as invalid:
        emit(invalid.line())
        return
    missing = missing_settings(settings)
    # Without a stored app password nothing can be emailed either (spec §9).
    # Only its absence is reported, never the password itself.
    if not missing and lookup_password(settings["senderAddress"]) is None:
        missing = ["appPassword"]
    if missing:
        emit({"setupNeeded": True, "missing": missing})
    # What the Picker shows besides Books, so these defaults live only here.
    # Routes go by id ("email", "usb"); the Picker names them itself.
    emit({"bookFolders": book_folder_setting(settings)})
    books = scan_folders(book_folders(settings)) if folders_wanted else []
    books += [Path(f) for f in files if Path(f).is_file() and supported(Path(f))]
    unique = {}
    for book in books:
        unique.setdefault(book.resolve(), book)
    limit, sent = email_limit(), last_sent(read_history())
    rows = [classify(book, limit, sent) for book in unique.values()]
    rows.sort(key=lambda row: row["mtime"], reverse=True)
    for row in rows:
        emit(row)


# --- USB route (spec §7) ----------------------------------------------------


KINDLE_VENDOR_ID = "1949"  # Amazon's USB vendor id


def run_tool(argv):
    """Run a system tool; (returncode, stdout, stderr), or (None, "", error) if it's missing."""
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as error:
        return None, "", str(error)
    return out.returncode, out.stdout, out.stderr


def usb_vendor(device):
    code, out, _ = run_tool(["udevadm", "info", "--query=property", f"--name={device}"])
    if code != 0:
        return None
    for line in out.splitlines():
        key, _, value = line.partition("=")
        if key == "ID_VENDOR_ID":
            return value.strip().lower()
    return None


def find_kindle():
    """The mounted Kindle as {"mount", "partition", "device"}, or None.

    A mounted block device (whole disk or partition) whose USB vendor id is Amazon's.
    """
    code, out, _ = run_tool(["lsblk", "-J", "-l", "-o", "NAME,PATH,PKNAME,TYPE,MOUNTPOINTS"])
    if code != 0:
        return None
    try:
        devices = json.loads(out).get("blockdevices") or []
    except (ValueError, AttributeError):
        return None
    for dev in devices:
        mounts = [m for m in (dev.get("mountpoints") or []) if m and m.startswith("/")]
        if not mounts or not dev.get("path") or usb_vendor(dev["path"]) != KINDLE_VENDOR_ID:
            continue
        parent = dev.get("pkname")
        return {"mount": mounts[0], "partition": dev["path"],
                "device": f"/dev/{parent}" if parent else dev["path"]}
    return None


def free_space(mount):
    return shutil.disk_usage(mount).free


def kindle_status():
    kindle = find_kindle()
    if kindle is None:
        return {"present": False}
    return {"present": True, "mount": kindle["mount"], "free": free_space(kindle["mount"])}


def copy_to_kindle(source, mount):
    """Copy `source` into documents/ under a temporary name, then rename and flush (spec §7)."""
    documents = Path(mount) / "documents"
    documents.mkdir(exist_ok=True)
    part = documents / f".{source.name}.part"
    try:
        with open(source, "rb") as src, open(part, "wb") as dst:
            shutil.copyfileobj(src, dst, 1024 * 1024)
            dst.flush()
            os.fsync(dst.fileno())
        os.replace(part, documents / source.name)  # replaces a same-name file
        fd = os.open(documents, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError as error:
        with contextlib.suppress(OSError):
            part.unlink()
        raise SendFailed("copy_failed", detail=str(error.strerror or error)) from None


def eject():
    """Unmount the Kindle and power it off (spec §7)."""
    kindle = find_kindle()
    if kindle is None:
        return not_ejected("eject_no_kindle")
    for argv in (["udisksctl", "unmount", "-b", kindle["partition"]],
                 ["udisksctl", "power-off", "-b", kindle["device"]]):
        code, out, err = run_tool(argv)
        if code != 0:
            lines = [l.strip() for l in (err or out).splitlines() if l.strip()]
            if lines:
                return not_ejected("eject_failed", detail=lines[0])
            return not_ejected("eject_step_failed", step=argv[1])
    return {"ejected": True}


def not_ejected(code, **values):
    message = said(code, **values)
    return {"ejected": False, "code": code, "values": message["values"], "reason": message["text"]}


EBOOK_CONVERT = "ebook-convert"
CONVERSION_TIMEOUT = 600


def convert_for_usb(book, workdir):
    """The AZW3 Conversion of an EPUB, written in `workdir` (spec §8). The EPUB is only read."""
    emit({"stage": "converting"})
    target = workdir / f"{book.stem}.azw3"
    try:
        out = subprocess.run([EBOOK_CONVERT, str(book), str(target)],
                             capture_output=True, text=True, timeout=CONVERSION_TIMEOUT)
    except FileNotFoundError:
        raise SendFailed("calibre_missing") from None
    except (OSError, subprocess.SubprocessError) as error:
        raise SendFailed("conversion_failed", detail=str(error).rstrip(".")) from None
    if out.returncode != 0 or not target.is_file():
        first = next((l.strip() for l in out.stderr.splitlines() if l.strip()),
                     f"ebook-convert exited with {out.returncode}")
        raise SendFailed("conversion_failed", detail=first.rstrip("."))
    return target


def send_usb(book):
    fmt = sendable(book, USB_FORMATS, "format_not_for_usb")
    kindle = find_kindle()
    if kindle is None:
        raise NoKindle()
    with tempfile.TemporaryDirectory(prefix="kindle-send-") as workdir:
        source = convert_for_usb(book, Path(workdir)) if fmt == "epub" else book
        size = source.stat().st_size
        if size > free_space(kindle["mount"]):
            raise SendFailed("kindle_full", mb=megabytes(size))
        emit({"stage": "copying"})
        copy_to_kindle(source, kindle["mount"])
    return {"result": "copied"}


# --- setup wizard (spec §9) -------------------------------------------------


AMAZON_DEVICES_HELP = "https://www.amazon.com/mycd"
APP_PASSWORDS_URL = "https://myaccount.google.com/apppasswords"
DEFAULT_LIMITS = {"minEmailGapSeconds": 10, "maxEmailsPerHour": 20}


class SetupCancelled(Exception):
    pass


def ask(prompt, current=None):
    """One line from the user; Enter keeps `current`. Never used for the password."""
    shown = f"{prompt} [{current}]: " if current else f"{prompt}: "
    while True:
        try:
            answer = input(shown).strip()
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None
        if answer:
            return answer
        if current:
            return current


def ask_address(prompt, current):
    while True:
        address = ask(prompt, current)
        if "@" in address and " " not in address:
            return address
        print("That doesn't look like an email address.")


def ask_yes_no(prompt, default):
    hint = "Y/n" if default else "y/N"
    while True:
        try:
            answer = input(f"{prompt} [{hint}]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None
        if not answer:
            return default
        if answer in ("y", "yes", "n", "no"):
            return answer.startswith("y")


def store_password(sender):
    """Let `secret-tool store` prompt in the terminal; the wizard never sees the password."""
    while True:
        print("Paste the app password at the prompt below (it isn't shown).")
        try:
            subprocess.run(["secret-tool", "store", "--label=kindle-send Gmail",
                            "service", "kindle-send", "user", sender])
        except OSError:
            print("secret-tool is missing. Install libsecret, then run setup again.")
            raise SetupCancelled from None
        if lookup_password(sender):
            print("App password stored in the keyring.")
            return
        print("Nothing was stored.")
        try:
            input("Press Enter to try again. ")
        except (EOFError, KeyboardInterrupt):
            raise SetupCancelled from None


def password_step(sender):
    print(f"\n3. Gmail app password. Create one at {APP_PASSWORDS_URL}")
    print("   (needs 2-Step Verification on the Google account).")
    if lookup_password(sender):
        if not ask_yes_no("An app password is stored. Replace it?", False):
            return
    store_password(sender)


def save_settings(updates):
    """Merge `updates` into the Settings file, keeping every other key (the Send limit
    numbers among them). SettingsInvalid if the file can't be read as JSON."""
    current = read_settings_file()
    if current is None:
        current = load_settings()  # the one-time copy from shell.json, if any
    settings = {**DEFAULT_LIMITS, **current, **updates}
    write_settings_file(settings)


def invalid_settings_stop(invalid):
    print(f"{invalid.path} isn't valid JSON, so setup won't touch it. Fix it and run setup again.")
    raise SetupCancelled from None


def wizard():
    try:
        current = load_settings()
    except SettingsInvalid as invalid:
        invalid_settings_stop(invalid)
    print("Books to Kindle setup. Press Enter to keep the value in [brackets].\n")

    print("1. Your Kindle's email address (…@kindle.com). Find it at")
    print(f"   amazon.com → Manage Your Content and Devices → Devices: {AMAZON_DEVICES_HELP}")
    kindle = ask_address("Kindle address", current.get("kindleAddress"))

    print("\n2. The Gmail address to send from.")
    sender = ask_address("Gmail address", current.get("senderAddress"))

    password_step(sender)

    print(f"\n4. Add {sender} to Amazon's Approved Personal Document Email List:")
    print(f"   {AMAZON_DEVICES_HELP} → Preferences → Personal Document Settings.")
    print("   Without this, Amazon silently drops every Book.")
    try:
        input("Press Enter when done. ")
    except (EOFError, KeyboardInterrupt):
        raise SetupCancelled from None

    print("\n5. Book folders the Picker lists, separated by commas.")
    folders = book_folder_setting(current)
    answer = ask("Book folders", ", ".join(folders))
    folders = [f.strip() for f in answer.split(",") if f.strip()]

    try:
        save_settings({"kindleAddress": kindle, "senderAddress": sender, "bookFolders": folders})
    except SettingsInvalid as invalid:
        invalid_settings_stop(invalid)
    except OSError as error:
        print(f"Couldn't write {settings_path()}: {error.strerror or error}.")
        raise SetupCancelled from None
    print(f"Settings saved to {settings_path()}.")

    if create_books_folder():
        print(f"Created {Path(os.path.expanduser(DEFAULT_BOOK_FOLDERS[0]))}.")

    print("\n7. Test send.")
    if ask_yes_no(f"Send a small test Book to {kindle} now?", True):
        run_test_send(kindle)
    print("\nSetup done.")


TEST_BOOK_TITLE = "Kindle Send Test"


def test_epub_path():
    """The bundled test EPUB: $KINDLE_SEND_TEST_EPUB, else assets/test.epub beside bin/."""
    override = os.environ.get("KINDLE_SEND_TEST_EPUB")
    if override:
        return Path(override)
    return Path(__file__).resolve().parent.parent / "assets" / "test.epub"


def send_test_book():
    """Email the test EPUB as "Kindle Send Test" (its subject) like any Send, recorded in
    the Send history. Returns the result line; progress lines go to stdout as usual."""
    with tempfile.TemporaryDirectory(prefix="kindle-send-") as tmp:
        book = Path(tmp) / f"{TEST_BOOK_TITLE}.epub"
        try:
            shutil.copyfile(test_epub_path(), book)
        except OSError:
            return SendFailed("test_book_missing").result()
        try:
            result = send_email(book)
        except SendFailed as failure:
            result = failure.result()
        record_send(book, "email", result)
    return result


def run_test_send(kindle):
    """The wizard's test send, then ask whether it arrived."""
    print("Sending…")
    with contextlib.redirect_stdout(io.StringIO()):  # no JSON progress lines here
        result = send_test_book()
    if result["result"] != "sent":
        print(f"The test send failed: {result['reason']}")
        print("Fix that and run `kindle-send setup` again.")
        return
    print("Gmail accepted it. Amazon never confirms delivery, so check your Kindle.")
    if ask_yes_no(f"Did '{TEST_BOOK_TITLE}' appear on your Kindle within a few minutes?", True):
        print("Books to Kindle is ready.")
        return
    print("The usual causes:")
    print("  - The Gmail address isn't on Amazon's Approved Personal Document Email List")
    print(f"    ({AMAZON_DEVICES_HELP} → Preferences → Personal Document Settings).")
    print(f"  - The Kindle address is wrong: check {kindle} against the one under")
    print("    Manage Your Content and Devices → Devices.")
    print("  - The Kindle is offline. It downloads the Book next time it's on Wi-Fi.")
    print("Fix it and run `kindle-send setup` again.")


def run_setup():
    if not sys.stdin.isatty():
        print("kindle-send setup needs a terminal. Run `kindle-send setup` in one.", file=sys.stderr)
        return 1
    try:
        wizard()
    except SetupCancelled:
        print("\nSetup cancelled.")
        return 1
    return 0


HISTORY_SHOWN = 20
RESULT_LABELS = {"sent": "Sent to Amazon", "copied": "Copied to Kindle"}


def history_line(entry):
    """`Nov 4 23:17 · Dune.epub · Email · Sent to Amazon`, in local time."""
    when = entry_time(entry).astimezone()
    stamp = f"{when:%b} {when.day} {when:%H:%M}"
    route = ROUTE_LABELS.get(entry.get("route"), str(entry.get("route")))
    result = RESULT_LABELS.get(entry.get("result"))
    if result is None:
        result = f"Failed: {entry['reason']}" if entry.get("reason") else "Failed"
    return " · ".join([stamp, str(entry.get("name")), route, result])


def show_history():
    """Print the last 20 Sends, newest first."""
    entries = [e for e in read_history() if entry_time(e) is not None]
    entries.sort(key=entry_time, reverse=True)
    if not entries:
        print("No Sends yet.")
    for entry in entries[:HISTORY_SHOWN]:
        print(history_line(entry))
    return 0


def now():
    return datetime.now(timezone.utc)


def limit_settings():
    """(minEmailGapSeconds, maxEmailsPerHour) from settings; defaults for absent or unusable
    values, an unreadable Settings file among them (the Send itself says so)."""
    try:
        settings = load_settings()
    except SettingsInvalid:
        settings = {}

    def number(name, lowest):
        value = settings.get(name)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or value < lowest:
            return DEFAULT_LIMITS[name]
        return value

    return number("minEmailGapSeconds", 0), int(number("maxEmailsPerHour", 1))


def send_limit():
    """`kindle-send limit`: when the next email may go (spec §11)."""
    gap, per_hour = limit_settings()
    current = now()
    emails = [e for e in read_history() if e.get("route") == "email" and e.get("result") == "sent"]
    times = sorted(t for t in map(entry_time, emails) if t is not None)
    ages = [(current - t).total_seconds() for t in times]
    last_hour = [a for a in ages if a < 3600]
    waits = [0] + [gap - a for a in ages[-1:]]
    if len(last_hour) >= per_hour:
        # The next may go once enough of the hour's emails are over an hour old.
        waits.append(3600 - last_hour[len(last_hour) - per_hour])
    wait = max(waits)
    emit({"canSendIn": math.ceil(wait), "sentLastHour": len(last_hour), "maxEmailsPerHour": per_hour})
    return 0


def pick(files):
    """Open the Picker with just these Books, already marked (spec §4). Strata's action runs this."""
    books, skipped = [], []
    for name in files:
        path = Path(os.path.abspath(name))
        (books if path.is_file() and supported(path) else skipped).append(path)
    if skipped:
        print("Left out, Kindle can't take these: " + ", ".join(p.name for p in skipped), file=sys.stderr)
    if not books:
        return 1
    code, _, error = run_tool(["omarchy-shell", "shell", "summon", PLUGIN_ID,
                               json.dumps({"files": [str(b) for b in books]})])
    if code != 0:
        print(f"Couldn't open the Picker: {error.strip() or 'omarchy-shell failed'}", file=sys.stderr)
        return 1
    return 0


def sender_address(settings):
    """The Gmail address in `settings`, trimmed; "" when none is set."""
    return str(settings.get("senderAddress") or "").strip()


def password_stored(settings):
    """Whether an app password is stored for the Gmail address set (never the password itself)."""
    sender = sender_address(settings)
    return bool(sender and lookup_password(sender))


def setup_missing(settings):
    """Every value setup still needs, in form order (spec §4, Setup needed)."""
    missing = missing_settings(settings)
    if not password_stored(settings):
        missing.append("appPassword")
    return missing


def form_settings():
    """`kindle-send settings`: the values the Settings form shows (spec §3), and what's
    still missing, which titles the form and flags its fields. Never the password.
    An unreadable Settings file is reported instead, never taken for missing values."""
    try:
        current = load_settings()
    except SettingsInvalid as invalid:
        emit(invalid.line())
        return 0
    missing = setup_missing(current)
    emit({"kindleAddress": str(current.get("kindleAddress") or "").strip(),
          "senderAddress": sender_address(current),
          "bookFolders": book_folder_setting(current),
          "appPasswordStored": "appPassword" not in missing,
          "missing": missing})
    return 0


def form_values(raw):
    """The form's values from `save`'s stdin, trimmed; Book folders as a list, defaults if empty."""
    def text(key):
        value = raw.get(key)
        return value.strip() if isinstance(value, str) else ""
    folders = raw.get("bookFolders")
    if isinstance(folders, str):
        folders = folders.split(",")
    if not isinstance(folders, list):
        folders = []
    folders = [f.strip() for f in folders if isinstance(f, str) and f.strip()]
    return {"kindleAddress": text("kindleAddress"), "senderAddress": text("senderAddress"),
            "bookFolders": folders or list(DEFAULT_BOOK_FOLDERS)}


def is_email_address(text):
    """Loosely an email address: one @, no spaces, something before it and a dotted domain after."""
    local, at, domain = text.partition("@")
    return (bool(at and local) and "@" not in domain and not any(c.isspace() for c in text)
            and "." in domain and not domain.startswith(".") and not domain.endswith("."))


# The Settings form's fields in the order it shows them, so problems come back in that order.
FORM_FIELDS = ("kindleAddress", "senderAddress", "appPassword", "bookFolders")


def problem(field, code, blocking, **values):
    """A Settings-form problem: its field, message code, values and English message."""
    message = said(code, **values)
    return {"field": field, "code": code, "values": message["values"], "message": message["text"],
            "blocking": blocking}


def needed(field):
    """A missing value: it blocks saving, and the form counts these ("N still needed …")."""
    return {**problem(field, "value_needed", True), "needed": True}


def blocking_problems(values, has_password):
    """What stops saving: an empty address or one that isn't an email address, or no app
    password, neither typed nor stored for the Gmail address (`has_password`)."""
    problems = []
    for field in EMAIL_SETTINGS:
        if not values[field]:
            problems.append(needed(field))
        elif not is_email_address(values[field]):
            problems.append(problem(field, "not_an_email_address", True))
    if not has_password:
        problems.append(needed("appPassword"))
    return problems


def value_warnings(values):
    """Unusual but valid values: they save, and the form says why they might be wrong."""
    found = []
    if not values["kindleAddress"].lower().endswith("@kindle.com"):
        found.append(problem("kindleAddress", "kindle_address_unusual", False))
    if not values["senderAddress"].lower().endswith("@gmail.com"):
        found.append(problem("senderAddress", "sender_not_gmail", False))
    absent = [f for f in values["bookFolders"] if not Path(os.path.expanduser(f)).is_dir()]
    if len(absent) == 1:
        found.append(problem("bookFolders", "book_folder_missing", False, folder=absent[0]))
    elif absent:
        found.append(problem("bookFolders", "book_folders_missing", False, folders=absent))
    return found


def typed_password(raw):
    """The app password typed into the form, or "" if none was (spaces at the ends dropped)."""
    password = raw.get("appPassword")
    return password.strip() if isinstance(password, str) else ""


def check_password(sender, password):
    """Sign in to Gmail without sending (spec §9): ("accepted" | "rejected" |
    "unreachable" | "untrusted", detail). "untrusted": Gmail's certificate
    couldn't be verified, so the password was never sent."""
    try:
        with connect_gmail() as server:
            server.ehlo()
            sign_in(server, sender, password)
    except ssl.SSLCertVerificationError as error:
        return "untrusted", certificate_problem(error).replace(password, "***")
    except smtplib.SMTPAuthenticationError:
        return "rejected", ""
    except (smtplib.SMTPException, OSError):
        return "unreachable", ""
    return "accepted", ""


def store_typed_password(sender, password):
    """Store the app password under `sender`, handing it to `secret-tool store` on stdin,
    never on its command line (ADR 0001). None when stored, else the problem to show."""
    try:
        subprocess.run(["secret-tool", "store", "--label=kindle-send Gmail",
                        "service", "kindle-send", "user", sender],
                       input=password, text=True, capture_output=True)
    except OSError:
        return problem("appPassword", "secret_tool_missing", True)
    if lookup_password(sender) != password:
        return problem("appPassword", "password_not_stored", True)
    return None


def create_books_folder():
    """Create ~/Books if it's missing; True if it was created. A failure is left to the
    Book folders warning, as for any folder that doesn't exist."""
    books = Path(os.path.expanduser(DEFAULT_BOOK_FOLDERS[0]))
    if books.is_dir():
        return False
    try:
        books.mkdir(parents=True)
    except OSError:
        return False
    return True


def save_form():
    """`kindle-send save`: check the form's values and write them to the Settings file (spec §3, §9).
    Reads one JSON line on stdin. Prints {"saved": bool, "firstSave"?: true, "problems": [{"field", "code", "values", "message", "blocking"}]};
    field "" is about the whole form."""
    try:
        raw = json.loads(sys.stdin.readline())  # one line, so the Picker needs no EOF
    except ValueError:
        raw = None
    if not isinstance(raw, dict):
        emit({"saved": False, "problems": [problem("", "form_unreadable", True)]})
        return 0
    values = form_values(raw)
    sender = values["senderAddress"]
    typed = typed_password(raw)
    blocking = blocking_problems(values, bool(typed or (sender and lookup_password(sender))))
    if blocking:
        emit({"saved": False, "problems": blocking})
        return 0
    password_problems = []
    try:
        before = load_settings()
    except SettingsInvalid as invalid:
        emit({"saved": False, "problems": [problem("", "settings_file_invalid", True, path=str(invalid.path))]})
        return 0
    # The save that completes setup is the first; it creates ~/Books, as the wizard does.
    first_save = bool(setup_missing(before))
    address_changed = sender != sender_address(before)
    # A changed address is checked with the password already stored for it, if any.
    password = typed or (lookup_password(sender) if address_changed else None)
    if password:
        outcome, detail = check_password(sender, password)
        if outcome == "rejected":
            emit({"saved": False, "problems": [problem("appPassword", "app_password_rejected", True)]})
            return 0
        if outcome == "unreachable":
            password_problems.append(problem("appPassword", "password_check_unreachable", False))
        if outcome == "untrusted":
            password_problems.append(problem("appPassword", "password_check_untrusted", False, detail=detail))
    if typed:
        stored = store_typed_password(sender, typed)
        if stored:
            emit({"saved": False, "problems": [stored]})
            return 0
    try:
        save_settings(values)
    except SettingsInvalid as invalid:
        emit({"saved": False, "problems": [problem("", "settings_file_invalid", True, path=str(invalid.path))]})
        return 0
    except OSError as error:
        unwritable = problem("", "settings_file_unwritable", True, path=str(settings_path()),
                             detail=str(error.strerror or error))
        emit({"saved": False, "problems": [unwritable]})
        return 0
    if first_save:
        create_books_folder()
    found = sorted(value_warnings(values) + password_problems, key=lambda p: FORM_FIELDS.index(p["field"]))
    answer = {"saved": True, "problems": found}
    if first_save:
        answer["firstSave"] = True  # the Picker suggests the test send after it (spec §9)
    emit(answer)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="kindle-send")
    sub = parser.add_subparsers(dest="command", required=True)
    send = sub.add_parser("send", help="send one Book")
    send.add_argument("--route", choices=["email", "usb"], required=True)
    send.add_argument("file", nargs="?")
    send.add_argument("--test", action="store_true",
                      help='instead of FILE: email the bundled test Book as "Kindle Send Test"')
    sub.add_parser("setup", help="interactive setup wizard (needs a terminal)")
    sub.add_parser("settings", help="the Settings for the Picker's form (never the password)")
    sub.add_parser("save", help="check and save the Settings form's values, read as JSON on stdin")
    plan_parser = sub.add_parser("plan", help="classify Books for the Picker")
    plan_parser.add_argument("--folders", action="store_true", help="scan the Book folders")
    plan_parser.add_argument("files", nargs="*")
    sub.add_parser("kindle", help="is the Kindle plugged in over USB?")
    sub.add_parser("eject", help="unmount and power off the Kindle")
    sub.add_parser("history", help="print the last 20 Sends")
    sub.add_parser("limit", help="when the next email may go")
    sub.add_parser("formats", help="list the supported formats (read by the file-manager items)")
    pick_parser = sub.add_parser("pick", help="open the Picker with just these Books (Strata's action)")
    pick_parser.add_argument("files", nargs="+")
    args = parser.parse_args(argv)
    if args.command == "send":
        if args.test and args.route != "email":
            send.error("--test sends by email only: use --route email")
        if args.test == bool(args.file):
            send.error("give either FILE or --test")

    if args.command == "kindle":
        emit(kindle_status())
        return 0
    if args.command == "eject":
        emit(eject())
        return 0

    if args.command == "history":
        return show_history()
    if args.command == "limit":
        return send_limit()

    if args.command == "formats":
        emit({"formats": sorted(set(EMAIL_MIME) | USB_FORMATS)})
        return 0

    if args.command == "pick":
        return pick(args.files)
    if args.command == "plan":
        plan(args.folders, args.files)
        return 0
    if args.command == "setup":
        return run_setup()
    if args.command == "settings":
        return form_settings()
    if args.command == "save":
        return save_form()

    if args.command == "send" and args.test:
        emit(send_test_book())
        return 0
    if args.command == "send":
        book = Path(args.file)
        try:
            result = send_usb(book) if args.route == "usb" else send_email(book)
        except NoKindle as failure:
            emit(failure.result())
            return 0
        except SendFailed as failure:
            result = failure.result()
        record_send(book, args.route, result)
        emit(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
